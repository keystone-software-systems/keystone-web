# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=          # service role — server only, never public

# App
# Base URL this app is served from — used to build the magic-link redirect.
APP_BASE_URL=http://localhost:3000

# Resend — new-submission notification to the founder (/submit). Optional:
# skipped silently if RESEND_API_KEY is unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Keystone Systems <onboarding@resend.dev>
FOUNDER_NOTIFICATION_EMAIL=tanner@propdog.ai
