# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=          # service role — server only, never public

# App
# Base URL this app is served from — used to build the magic-link redirect.
APP_BASE_URL=http://localhost:3000

# Prospect sourcing (app/api/cron/prospect-feeds)
PRODUCT_HUNT_API_TOKEN=
# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` — set the same value
# on the Vercel project so only the scheduled cron can call this route.
CRON_SECRET=
